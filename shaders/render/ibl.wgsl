// render/ibl.wgsl: image-based-light preprocessing [LIT-01], compute only, run when the
// environment changes (never per frame):
//   generate:         a procedural environment into the faces of a cube (studio with or without
//                     its softbox panels, overcast, clear sky, sunset, uniform): generated by code,
//                     not a measurement of a real place;
//   equirect_to_cube: an imported latitude-longitude HDR image (Radiance HDR or EXR) into a cube;
//   downsample:       one mip level of the cube from the level above (2x2 box);
//   prefilter:        one mip level of the GGX-prefiltered specular cube (roughness = level /
//                     (levels - 1)), importance-sampled with filtered importance sampling (Krivanek
//                     and Colbert 2008: the source mip from the sample's solid angle);
//   irradiance_sh:    L2 spherical harmonics of the environment convolved with the clamped cosine
//                     (Ramamoorthi and Hanrahan 2001), one workgroup, deterministic tree reduction;
//   dfg:              the split-sum DFG table (A, B) over (n.v, perceptual roughness).
// Cube faces follow WebGPU: +X, -X, +Y, -Y, +Z, -Z; face coordinates s right, t down.

#include "lib/brdf.wgsl"

struct IblParams {
    // Face size of the level written, its mip index, samples, procedural kind.
    size: u32,
    mip: u32,
    sample_count: u32,
    kind: u32,
    // Perceptual roughness of the level, face size of the source level 0, mip count of the source,
    // unused.
    roughness: f32,
    source_size: f32,
    source_mips: f32,
    pad: f32,
    // Unit vector towards the sun (clear sky); w unused.
    sun: vec4<f32>,
}

@group(0) @binding(0) var<uniform> ibl: IblParams;
@group(0) @binding(1) var cube_out: texture_storage_2d_array<rgba16float, write>;
@group(0) @binding(2) var equirect: texture_2d<f32>;
@group(0) @binding(3) var linear_sampler: sampler;
@group(0) @binding(4) var cube_level: texture_2d_array<f32>;
@group(0) @binding(5) var env_cube: texture_cube<f32>;
@group(0) @binding(6) var<storage, read_write> sh_out: array<vec4<f32>, 9>;
@group(0) @binding(7) var lut_out: texture_storage_2d<rgba16float, write>;

const KIND_STUDIO: u32 = 0u;
const KIND_OVERCAST: u32 = 1u;
const KIND_CLEAR_SKY: u32 = 2u;
const KIND_UNIFORM: u32 = 3u;
const KIND_SUNSET: u32 = 4u;
const KIND_STUDIO_ROOM: u32 = 5u;

// The direction through texel `xy` of face `face` of a cube with faces of `size` texels.
fn cube_direction(face: u32, xy: vec2<u32>, size: u32) -> vec3<f32> {
    let st = (vec2<f32>(xy) + 0.5) / f32(size) * 2.0 - 1.0;
    let s = st.x;
    let t = st.y;
    var d: vec3<f32>;
    switch (face) {
        case 0u: { d = vec3<f32>(1.0, -t, -s); }
        case 1u: { d = vec3<f32>(-1.0, -t, s); }
        case 2u: { d = vec3<f32>(s, 1.0, t); }
        case 3u: { d = vec3<f32>(s, -1.0, -t); }
        case 4u: { d = vec3<f32>(s, -t, 1.0); }
        default: { d = vec3<f32>(-s, -t, -1.0); }
    }
    return normalize(d);
}

// A soft-edged rectangular panel of half-size `half` (tangent units) around `center`.
fn panel(d: vec3<f32>, center: vec3<f32>, half: vec2<f32>) -> f32 {
    let c = normalize(center);
    let facing = dot(d, c);
    if (facing <= 0.0) {
        return 0.0;
    }
    var up = vec3<f32>(0.0, 1.0, 0.0);
    if (abs(c.y) > 0.95) {
        up = vec3<f32>(0.0, 0.0, 1.0);
    }
    let right = normalize(cross(c, up));
    let up2 = cross(right, c);
    let p = vec2<f32>(dot(d, right), dot(d, up2)) / facing;
    let q = abs(p) / half;
    return (1.0 - smoothstep(0.85, 1.0, q.x)) * (1.0 - smoothstep(0.85, 1.0, q.y));
}

// The dark studio room: dim grey walls brightening upwards, a darker floor.
fn studio_room(d: vec3<f32>) -> vec3<f32> {
    if (d.y < -0.05) {
        return vec3<f32>(0.12);
    }
    return vec3<f32>(mix(0.18, 0.35, saturate(d.y * 0.5 + 0.5)));
}

// The procedural environments (relative radiance; the rig scales it to nits).
fn procedural(d: vec3<f32>) -> vec3<f32> {
    switch (ibl.kind) {
        case KIND_STUDIO: {
            // The room and three softbox panels.
            var c = studio_room(d);
            c += vec3<f32>(14.0) * panel(d, vec3<f32>(0.8, 0.45, 0.9), vec2<f32>(0.22, 0.3));
            c += vec3<f32>(5.0) * panel(d, vec3<f32>(-0.9, 0.1, 0.7), vec2<f32>(0.2, 0.28));
            c += vec3<f32>(8.0) * panel(d, vec3<f32>(0.0, 0.8, -0.6), vec2<f32>(0.4, 0.12));
            return c;
        }
        case KIND_STUDIO_ROOM: {
            // The room alone: the softboxes are the rig's rect lights.
            return studio_room(d);
        }
        case KIND_SUNSET: {
            // A sun near the horizon: the sky is deep blue overhead and turns orange in a band
            // along the horizon that is brightest and widest around the sun; the ground is dark
            // and takes a little of the sky's warmth.
            let sun = normalize(ibl.sun.xyz);
            let up = saturate(d.y);
            let flat_d = safe_normalize(vec3<f32>(d.x, 0.0, d.z), vec3<f32>(0.0, 0.0, 1.0));
            let flat_sun = safe_normalize(vec3<f32>(sun.x, 0.0, sun.z), vec3<f32>(0.0, 0.0, 1.0));
            // 1 towards the sun's side of the horizon, 0 opposite.
            let towards = 0.5 + 0.5 * dot(flat_d, flat_sun);
            let zenith = vec3<f32>(0.10, 0.17, 0.42);
            let band = mix(vec3<f32>(0.55, 0.36, 0.38), vec3<f32>(1.6, 0.62, 0.16), towards * towards);
            let height = mix(0.12, 0.3, towards);
            var c = mix(band, zenith, saturate(pow(up / height, 0.7) * 0.75 + up * 0.25));
            let cos_sun = saturate(dot(d, sun));
            c += vec3<f32>(1.0, 0.45, 0.12) * (1.2 * pow(cos_sun, 24.0) + 6.0 * pow(cos_sun, 600.0));
            if (d.y < 0.0) {
                let ground = vec3<f32>(0.05, 0.04, 0.035) + vec3<f32>(0.06, 0.03, 0.012) * towards;
                c = mix(c, ground, smoothstep(0.0, 0.03, -d.y));
            }
            return c;
        }
        case KIND_OVERCAST: {
            // CIE standard overcast sky: L(theta) = Lz (1 + 2 cos theta) / 3; below the horizon a
            // ground of albedo 0.2 lit by it (irradiance 7 pi Lz / 9, radiance 0.2 * 7 / 9 Lz).
            if (d.y >= 0.0) {
                return vec3<f32>((1.0 + 2.0 * d.y) / 3.0);
            }
            return vec3<f32>(0.2 * 7.0 / 9.0);
        }
        case KIND_CLEAR_SKY: {
            let sun = normalize(ibl.sun.xyz);
            let up = saturate(d.y);
            let zenith = vec3<f32>(0.25, 0.45, 1.0);
            let horizon = vec3<f32>(0.85, 0.9, 1.0);
            var c = mix(horizon, zenith, pow(up, 0.45)) * 0.6;
            // Glow around the sun; its disk is a directional light of the rig.
            let cos_sun = saturate(dot(d, sun));
            c += vec3<f32>(1.0, 0.8, 0.55) * (0.6 * pow(cos_sun, 12.0) + 4.0 * pow(cos_sun, 400.0));
            if (d.y < 0.0) {
                c = vec3<f32>(0.11, 0.1, 0.09) * (0.5 + 0.5 * sun.y);
            }
            return c;
        }
        default: {
            return vec3<f32>(1.0);
        }
    }
}

@compute @workgroup_size(8, 8, 1)
fn generate(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x >= ibl.size || id.y >= ibl.size || id.z >= 6u) {
        return;
    }
    let d = cube_direction(id.z, id.xy, ibl.size);
    textureStore(cube_out, id.xy, id.z, vec4<f32>(procedural(d), 1.0));
}

@compute @workgroup_size(8, 8, 1)
fn equirect_to_cube(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x >= ibl.size || id.y >= ibl.size || id.z >= 6u) {
        return;
    }
    let d = cube_direction(id.z, id.xy, ibl.size);
    // Longitude 0 at -Z, increasing towards +X; latitude from +Y.
    let u = atan2(d.x, -d.z) * INV_TAU + 0.5;
    let v = acos(clamp(d.y, -1.0, 1.0)) * INV_PI;
    let c = textureSampleLevel(equirect, linear_sampler, vec2<f32>(u, v), 0.0).rgb;
    textureStore(cube_out, id.xy, id.z, vec4<f32>(max(c, vec3<f32>(0.0)), 1.0));
}

@compute @workgroup_size(8, 8, 1)
fn downsample(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x >= ibl.size || id.y >= ibl.size || id.z >= 6u) {
        return;
    }
    let base = vec2<i32>(id.xy * 2u);
    let layer = i32(id.z);
    var c = textureLoad(cube_level, base, layer, 0).rgb;
    c += textureLoad(cube_level, base + vec2<i32>(1, 0), layer, 0).rgb;
    c += textureLoad(cube_level, base + vec2<i32>(0, 1), layer, 0).rgb;
    c += textureLoad(cube_level, base + vec2<i32>(1, 1), layer, 0).rgb;
    textureStore(cube_out, id.xy, id.z, vec4<f32>(0.25 * c, 1.0));
}

@compute @workgroup_size(8, 8, 1)
fn prefilter(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x >= ibl.size || id.y >= ibl.size || id.z >= 6u) {
        return;
    }
    let n = cube_direction(id.z, id.xy, ibl.size);
    if (ibl.mip == 0u || ibl.roughness <= 0.0) {
        textureStore(cube_out, id.xy, id.z, vec4<f32>(textureSampleLevel(env_cube, linear_sampler, n, 0.0).rgb, 1.0));
        return;
    }
    let alpha = alpha_from_roughness(ibl.roughness);
    let basis = orthonormal_basis(n);
    let count = max(ibl.sample_count, 1u);
    // Solid angle of one texel of the source's level 0.
    let texel_solid_angle = 4.0 * PI / (6.0 * ibl.source_size * ibl.source_size);
    var sum = vec3<f32>(0.0);
    var weight = 0.0;
    for (var i = 0u; i < count; i++) {
        let h = from_local(basis, sample_ggx_ndf(hammersley(i, count), alpha));
        let v_dot_h = dot(n, h);
        let l = 2.0 * v_dot_h * h - n;
        let n_dot_l = dot(n, l);
        if (n_dot_l > 0.0) {
            // N = V: pdf(l) = D(h) (n.h) / (4 v.h) = D / 4.
            let pdf = d_ggx(saturate(v_dot_h), alpha) * 0.25;
            let sample_solid_angle = 1.0 / (f32(count) * max(pdf, 1e-8));
            let lod = clamp(0.5 * log2(sample_solid_angle / texel_solid_angle) + 1.0, 0.0, ibl.source_mips - 1.0);
            sum += textureSampleLevel(env_cube, linear_sampler, l, lod).rgb * n_dot_l;
            weight += n_dot_l;
        }
    }
    textureStore(cube_out, id.xy, id.z, vec4<f32>(sum / max(weight, 1e-8), 1.0));
}

const SH_THREADS: u32 = 256u;
var<workgroup> sh_partial: array<vec4<f32>, 256>;

// The nine real SH basis functions (l <= 2) at a unit direction.
fn sh_basis(d: vec3<f32>, k: u32) -> f32 {
    switch (k) {
        case 0u: { return 0.282095; }
        case 1u: { return 0.488603 * d.y; }
        case 2u: { return 0.488603 * d.z; }
        case 3u: { return 0.488603 * d.x; }
        case 4u: { return 1.092548 * d.x * d.y; }
        case 5u: { return 1.092548 * d.y * d.z; }
        case 6u: { return 0.315392 * (3.0 * d.z * d.z - 1.0); }
        case 7u: { return 1.092548 * d.x * d.z; }
        default: { return 0.546274 * (d.x * d.x - d.y * d.y); }
    }
}

@compute @workgroup_size(256, 1, 1)
fn irradiance_sh(@builtin(local_invocation_index) thread: u32) {
    let per_thread = max(ibl.sample_count / SH_THREADS, 1u);
    let total = per_thread * SH_THREADS;
    // The source level whose texels are about the size of one sample.
    let lod = clamp(0.5 * log2(6.0 * ibl.source_size * ibl.source_size / f32(total)), 0.0, ibl.source_mips - 1.0);
    for (var k = 0u; k < 9u; k++) {
        var acc = vec3<f32>(0.0);
        for (var i = 0u; i < per_thread; i++) {
            let d = sample_uniform_sphere(hammersley(thread * per_thread + i, total));
            acc += textureSampleLevel(env_cube, linear_sampler, d, lod).rgb * sh_basis(d, k);
        }
        sh_partial[thread] = vec4<f32>(acc, 0.0);
        workgroupBarrier();
        for (var stride = SH_THREADS / 2u; stride > 0u; stride = stride / 2u) {
            if (thread < stride) {
                sh_partial[thread] += sh_partial[thread + stride];
            }
            workgroupBarrier();
        }
        if (thread == 0u) {
            // Monte Carlo over the sphere (4 pi / N), then the clamped-cosine band factors
            // A0 = pi, A1 = 2 pi / 3, A2 = pi / 4: the coefficients of the irradiance.
            var band = PI / 4.0;
            if (k == 0u) {
                band = PI;
            } else if (k < 4u) {
                band = 2.0 * PI / 3.0;
            }
            sh_out[k] = vec4<f32>(sh_partial[0].rgb * (4.0 * PI / f32(total)) * band, 0.0);
        }
        workgroupBarrier();
    }
}

@compute @workgroup_size(8, 8, 1)
fn dfg(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x >= ibl.size || id.y >= ibl.size) {
        return;
    }
    let n_dot_v = (f32(id.x) + 0.5) / f32(ibl.size);
    let roughness = (f32(id.y) + 0.5) / f32(ibl.size);
    let ab = integrate_dfg(n_dot_v, alpha_from_roughness(roughness), ibl.sample_count);
    textureStore(lut_out, id.xy, vec4<f32>(ab, 0.0, 1.0));
}
